# Scam Checker - Environment Variables
# Copy this file to .env and fill in your API keys

# Server
PORT=3001
NODE_ENV=development

# Reddit API (for Reddit search)
# Get credentials at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=ScamChecker/1.0

# Google Search API (choose one)
# Option 1: Serper API (recommended - easier setup)
# Get key at: https://serper.dev/
SERPER_API_KEY=your_serper_api_key

# Option 2: Google Custom Search API
# Get key at: https://developers.google.com/custom-search/v1/overview
# GOOGLE_API_KEY=your_google_api_key
# GOOGLE_CSE_ID=your_custom_search_engine_id

# Reputation Databases (optional but recommended)
# PhishTank - Get key at: https://phishtank.org/developer_info.php
PHISHTANK_API_KEY=your_phishtank_api_key

# URLVoid - Get key at: https://www.urlvoid.com/api/
URLVOID_API_KEY=your_urlvoid_api_key

# VirusTotal - Get key at: https://www.virustotal.com/gui/sign-up
VIRUSTOTAL_API_KEY=your_virustotal_api_key